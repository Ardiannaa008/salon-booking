# Copy this file to .env and fill in your own values. Never commit .env.

# Database. This value matches `npm run db:local`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/salon

PORT=3000

# Password for the admin page and admin endpoints (at least 8 characters).
ADMIN_PASSWORD=change-me-please

# resend = send real emails. fake = send nothing, for local testing.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
# Resend's test sender only delivers to your own Resend account email.
# To email anyone else, verify a domain in Resend and use an address on it.
EMAIL_FROM=Studio Luna <onboarding@resend.dev>

# Retries after the first attempt (minimum 3), and the wait before each one.
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAYS_SECONDS=60,300,900

# With EMAIL_PROVIDER=fake: how many attempts of each job fail on purpose.
FAKE_EMAIL_FAIL_ATTEMPTS=0

# true = the worker runs inside the web server. false = run it with `npm run worker`.
START_WORKER=true
WORKER_POLL_INTERVAL_MS=5000

SALON_NAME=Studio Luna
SALON_TIMEZONE=Europe/Berlin

# Bookings allowed per visitor every 15 minutes.
BOOKING_RATE_LIMIT_MAX=5

# Header holding the visitor's real IP, set by the proxy in front of the app.
# Leave empty locally. On Render, it defaults to cf-connecting-ip.
CLIENT_IP_HEADER=
